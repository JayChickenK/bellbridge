# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml must never be committed or shared.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# 32 random bytes, base64. Generate one with
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Home Assistant asks for this key when the device is added; it also secures OTA updates.
api_encryption_key: "paste-the-generated-key-here"
